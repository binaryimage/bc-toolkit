[{"name": "Truise Undertow", "category": "Bass", "settings": [["Osc 1 / Type", "Wavetable (Sound Edit > Osc > Wavetable Select: D-stort)"], ["Osc 1 / Tune", "-12 st, Fine -8"], ["Osc 1 / Wave (scan)", "24"], ["Osc 1 / Timbre (tone)", "60"], ["Osc 1 / Volume", "100 (est.)"], ["Osc 2 / Type", "VAnalog"], ["Osc 2 / Tune", "-12 st, Fine +8"], ["Osc 2 / Timbre (Shape)", "30"], ["Osc 2 / Volume", "85"], ["Filter / Type", "LP"], ["Filter / Cutoff", "42"], ["Filter / Resonance", "30"], ["Filter / Env Amt", "+40"], ["FX 1 / Type", "Chorus - Dark, Time (rate) 10, Amount 35"], ["FX 2 / Type", "Distortion - Tape, Time (gain) 70, Intensity 25, Amount 20"], ["FX 3 / Type", "Multi Comp - Bass Ctrl, Intensity 30, Amount 80"], ["Cycling Env / Mode", "Loop (also try Run)"], ["Cycling Env / Rise + Fall", "30 / 40"], ["LFO 1 / Rate", "1/2 synced, Retrig Free"], ["LFO 2 / Rate", "1/4 synced"], ["Matrix / LFO 1 > Osc 1 Wave", "+30"], ["Matrix / LFO 1 > Osc 1 Timbre", "+25"], ["Matrix / LFO 2 > Osc 2 Wave", "+20 (est.)"], ["Matrix / LFO 2 > Osc 2 Volume", "-15 (est.)"], ["Matrix / CycEnv > FX 2 Amount", "+45"], ["Matrix / CycEnv > FX 3 Amount", "+45"], ["Envelope / A D S R", "10 / 40 (est.) / 0 / 30"], ["Voice / Mode", "Mono"], ["Voice / Glide", "0 (off)"], ["Arp / Settings", "Up (est.), 1/16, Gate 50, Swing 55%"], ["Macro / M1", "Osc 1 Timbre -33, Osc 1 Shape -100"], ["Macro / M2", "FX 3 Amount +100, FX 2 Time (gain) +30"]], "seq": "Arp on, 1/16, gate 50, swing 55% at 90 BPM; hold a root plus its octave, or a minor triad.", "play": "A wobbling, chorused synthwave bass that moves on its own thanks to two synced LFOs on the wavetable. Ride M2 for more crunch; set swing to 50% for straighter darksynth drive.", "source": "https://www.attackmagazine.com/technique/synth-secrets/making-com-truise-style-basslines-with-minifreak-v/", "sourceName": "Attack Magazine: Com Truise basslines with MiniFreak V"}, {"name": "Impaled Stab", "category": "Bass", "settings": [["Preset / Load", "Factory 005 Impale"], ["Osc 1 + 2 / Tune", "-12 st (est.)"], ["Filter / Type", "LP"], ["Filter / Cutoff", "30 (est.)"], ["Filter / Resonance", "35 (est.)"], ["Filter / Env Amt", "+50 (est.)"], ["FX / Reverb slot", "Amount down to 15, or swap it for Multi Comp - Tighter (est.)"], ["Envelope / A D S R", "0 / 35 / 0 / 20 (est.)"], ["Voice / Mode", "Mono"], ["Voice / Glide", "0 (off)"]], "seq": "", "play": "Impale shows off the effects chain; a short envelope, an octave down and mono turn it into a nasty industrial stab. Play short 1/8 notes and push Env Amt with velocity.", "source": "https://www.guitarcenter.com/riffs/interviews/keyboards--midi/arturia-mini-freak", "sourceName": "Guitar Center Riffs (factory preset 5 Impale)"}, {"name": "Geiger Graveyard", "category": "Texture", "settings": [["Preset / Load", "Factory 010 Geiger Counter"], ["Filter / Cutoff", "15 lower than stored (est.)"], ["LFO 2 / Wave + Rate", "SnH, 0.4 Hz (est.), Retrig Free"], ["Matrix / LFO 2 > Osc 1 Wave", "+20 (est.)"], ["FX / Reverb slot", "Reverb - Dark Room, Time 70, Amount 40 (est.; only one reverb per chain)"], ["Envelope / Release", "70 (est.)"], ["Voice / Glide", "0 (off)"]], "seq": "", "play": "A fragile glitch patch whose macros break the sound apart; slower random wave modulation and a dark room tail push it into haunted-machine territory. Hold single low notes and work both touch strips.", "source": "https://www.guitarcenter.com/riffs/interviews/keyboards--midi/arturia-mini-freak", "sourceName": "Guitar Center Riffs (factory preset 10 Geiger Counter)"}, {"name": "Giga Saw Eclipse", "category": "Lead", "settings": [["Preset / Load", "Factory Giga Saw"], ["Filter / Type", "LP"], ["Filter / Cutoff", "40 (est.)"], ["Filter / Resonance", "20 (est.)"], ["Filter / Env Amt", "+35 (est.)"], ["Filter / Velo Amt (Shift+Env Amt)", "+25 (est.)"], ["FX 1 / Type", "Distortion - Germanium, gain 35, Amount 30 (est.)"], ["FX 2 / Type", "Delay - Ping-Pong Sync, 1/8D, feedback 35, Amount 25 (est.)"], ["FX 3 / Type", "Reverb - Dark Room, Time 45, Amount 25 (est.)"], ["Envelope / Attack + Release", "3 / 30 (est.)"], ["Voice / Mode", "Unison, 4 voices, low spread (est.)"], ["Voice / Glide", "0 (off)"]], "seq": "", "play": "Darkens the big factory supersaw into a darksynth lead: filter closed down, grit up front, ping-pong behind. Play minor-key melodies above C3 and lift the filter with velocity.", "source": "https://awesome.ecosyste.ms/projects/github.com%2Ftgerla%2Fminifreak-patches", "sourceName": "tgerla minifreak-patches (factory Giga Saw)"}, {"name": "Foundry Floor", "category": "Bass", "settings": [["Osc 1 / Type", "Bass"], ["Osc 1 / Tune", "-12 st"], ["Osc 1 / Wave (Saturate)", "60"], ["Osc 1 / Timbre (Fold)", "35"], ["Osc 1 / Shape (Noise)", "10"], ["Osc 1 / Volume", "100"], ["Osc 2 / Type", "BasicWaves"], ["Osc 2 / Tune", "-12 st, Fine +5"], ["Osc 2 / Wave (Morph)", "50 (saw)"], ["Osc 2 / Timbre (Sym)", "0"], ["Osc 2 / Shape (Sub)", "40"], ["Osc 2 / Volume", "50"], ["Filter / Type", "LP"], ["Filter / Cutoff", "28"], ["Filter / Resonance", "35"], ["Filter / Env Amt", "+55"], ["Filter / Velo Amt (Shift+Env Amt)", "+30"], ["FX 1 / Type", "Distortion - Classic, gain 40, Amount 40"], ["FX 2 / Type", "Multi Comp - Bass Ctrl, Intensity 40, Amount 60"], ["FX 3 / Type", "Off"], ["Envelope / A D S R", "0 / 30 / 10 / 15"], ["Voice / Mode", "Mono"], ["Voice / Glide", "0 (off)"], ["Seq / Rate", "1/16"]], "seq": "16 steps in D: D1 D1 D2 D1 D1 D1 D2 D1 F1 F1 F2 F1 C1 C1 C2 C1, gate 50. Mod lane 1 on Filter Cutoff with small accents on steps 3, 7, 11, 15.", "play": "A hard, folded Front 242-style running bass. Saturate and Fold are the character knobs; tweak Cutoff and Env Amt live while the sequence runs.", "source": "https://www.noiseengineering.us/blog/microfreak", "sourceName": "Built from: Noise Engineering Bass engine notes + Solidtrax Multi Comp tip"}, {"name": "Fifth Ward 808", "category": "Bass", "settings": [["Osc 1 / Type", "Waveshaper"], ["Osc 1 / Tune", "-12 st"], ["Osc 1 / Wave", "50 (sine region, est.)"], ["Osc 1 / Timbre (Amount)", "10"], ["Osc 1 / Shape (Asym)", "0"], ["Osc 1 / Volume", "100"], ["Osc 2 / Volume", "0"], ["Filter / Type", "LP"], ["Filter / Cutoff", "45"], ["Filter / Resonance", "0"], ["Filter / Env Amt", "+10"], ["FX 1 / Type", "Distortion - Tape, gain 25, Intensity -20 (LPF), Amount 30"], ["FX 2 / Type", "Multi Comp - Tighter, Amount 40"], ["Cycling Env / Mode", "Env"], ["Cycling Env / Rise / Fall / Hold", "0 / 15 / 0"], ["Matrix / CycEnv > Pitch 1+2", "+8 (est., about an octave drop)"], ["Envelope / A D S R", "2 / 60 / 70 / 25"], ["Voice / Mode", "Mono"], ["Voice / Glide", "0 (off)"]], "seq": "", "play": "Round sub with a quick 808-style pitch drop, warmed by tape grit for spooky lo-fi hip hop. Raise Waveshaper Amount for more harmonics on small speakers.", "source": "https://www.guitarcenter.com/riffs/interviews/keyboards--midi/arturia-mini-freak", "sourceName": "Built from: cycling-envelope-as-envelope technique"}, {"name": "Cold Iron Reese", "category": "Bass", "settings": [["Osc 1 / Type", "SawX"], ["Osc 1 / Tune", "-12 st"], ["Osc 1 / Wave (SawMod)", "40"], ["Osc 1 / Timbre (Shape)", "20"], ["Osc 1 / Shape (Noise)", "5"], ["Osc 2 / Type", "BasicWaves"], ["Osc 2 / Tune", "-12 st, Fine +12"], ["Osc 2 / Wave (Morph)", "50 (saw)"], ["Osc 2 / Shape (Sub)", "30"], ["Osc 2 / Volume", "70"], ["Filter / Type", "LP"], ["Filter / Cutoff", "35"], ["Filter / Resonance", "25"], ["Filter / Env Amt", "+15"], ["FX 1 / Type", "Distortion - Soft Clip, gain 45, Amount 50"], ["FX 2 / Type", "Chorus - Dark, Amount 25"], ["FX 3 / Type", "Multi Comp - OPP, Amount 50"], ["LFO 1 / Wave + Rate", "Sin, 0.3 Hz, Retrig Free"], ["Matrix / LFO 1 > Cutoff", "+10"], ["Envelope / A D S R", "2 / 50 / 80 / 20"], ["Voice / Mode", "Mono"], ["Voice / Glide", "0 (off)"]], "seq": "", "play": "Detuned, phasing low end for darksynth and industrial breakdowns. Long held notes; Osc 2 Fine sets how fast it beats.", "source": "https://www.noiseengineering.us/blog/microfreak", "sourceName": "Built from: Noise Engineering SawX notes + classic reese technique"}, {"name": "Chainlink Acid", "category": "Sequence", "settings": [["Osc 1 / Type", "BasicWaves"], ["Osc 1 / Tune", "-12 st"], ["Osc 1 / Wave (Morph)", "0 (square)"], ["Osc 1 / Timbre (Sym)", "30"], ["Osc 1 / Shape (Sub)", "0"], ["Osc 2 / Type", "Destroy"], ["Osc 2 / Wave (Fold)", "30"], ["Osc 2 / Timbre (Decimate)", "10"], ["Osc 2 / Shape (Bitcrush)", "0"], ["Osc 2 / Volume", "60 (dry/wet)"], ["Filter / Type", "LP"], ["Filter / Cutoff", "25"], ["Filter / Resonance", "70"], ["Filter / Env Amt", "+60"], ["Filter / Velo Amt (Shift+Env Amt)", "+40"], ["FX 1 / Type", "Distortion - Dual Fold, gain 30, Amount 35"], ["FX 2 / Type", "Delay - Filtered Sync, 3/16, Intensity 30, Amount 15"], ["Envelope / A D S R", "0 / 25 / 0 / 15"], ["Voice / Mode", "Mono"], ["Voice / Glide", "0 (off)"], ["Seq / Rate", "1/16"]], "seq": "16 steps in E Phrygian: E1 E1 E2 F1 E1 - G1 E1 E1 Bb1 E1 - E2 F1 E1 D2. Accent (high velocity) on steps 1, 4, 9 and 14. Mod lane 1 on Osc 2 Fold.", "play": "A squelchy, folded acid line for industrial techno and EBM. Turn Cutoff and Resonance by hand; hit Dice for variations.", "source": "https://solidtrax.nl/arturia-minifreak-review/", "sourceName": "Built from: Solidtrax review (Destroy on Osc 2, then distortion)"}, {"name": "Static Saint", "category": "Lead", "settings": [["Osc 1 / Type", "SuperWave"], ["Osc 1 / Wave", "Saw (est.)"], ["Osc 1 / Timbre (Detune)", "30"], ["Osc 1 / Shape (Volume)", "60"], ["Osc 2 / Type", "VAnalog"], ["Osc 2 / Tune", "+12 st"], ["Osc 2 / Wave (Detune)", "20"], ["Osc 2 / Timbre (Shape)", "40"], ["Osc 2 / Volume", "45"], ["Filter / Type", "LP"], ["Filter / Cutoff", "55"], ["Filter / Resonance", "20"], ["Filter / Env Amt", "+25"], ["FX 1 / Type", "Super Unison - Classic, Time 30, Amount 40"], ["FX 2 / Type", "Delay - Ping-Pong Sync, 1/8D, Intensity 35, Amount 25"], ["FX 3 / Type", "Reverb - Dark Room, Time 50, Amount 30"], ["Envelope / A D S R", "5 / 50 / 60 / 30"], ["Voice / Mode", "Mono"], ["Voice / Glide", "0 (off)"], ["Voice / Vibrato", "On the mod wheel (Shift+Keyboard/Wheel)"]], "seq": "", "play": "A wide, cutting darksynth lead without any slide. Add mod-wheel vibrato at phrase ends and lift Cutoff for choruses.", "source": "https://www.musicradar.com/reviews/arturia-minifreak-20-review", "sourceName": "Built from: MusicRadar review (Super Unison) + Solidtrax vibrato tip"}, {"name": "Wire Saint Sync", "category": "Lead", "settings": [["Osc 1 / Type", "VAnalog"], ["Osc 1 / Wave (Detune)", "10"], ["Osc 1 / Timbre (Shape)", "70 (sync-like edge)"], ["Osc 2 / Type", "BasicWaves"], ["Osc 2 / Tune", "-12 st"], ["Osc 2 / Wave (Morph)", "0 (square)"], ["Osc 2 / Volume", "35"], ["Filter / Type", "LP"], ["Filter / Cutoff", "70"], ["Filter / Resonance", "10"], ["Filter / Env Amt", "+15"], ["FX 1 / Type", "Distortion - Germanium, gain 40, Amount 40"], ["FX 2 / Type", "Delay - Mono Sync, 1/4, Intensity 25, Amount 20"], ["Cycling Env / Mode", "Env"], ["Cycling Env / Rise / Fall / Hold", "0 / 35 / 0"], ["Matrix / CycEnv > Osc 1 Timbre", "+30"], ["Envelope / A D S R", "0 / 40 / 70 / 15"], ["Voice / Mode", "Mono"], ["Voice / Glide", "0 (off)"]], "seq": "", "play": "A snarling sync-sweep lead in the EBM mould: every note opens with a tearing sweep. Play staccato riffs; lengthen Fall for a slower tear.", "source": "https://forums.musicplayer.com/topic/184514-in-the-lab-arturia-minifreak-v-and-minifreak-redux/", "sourceName": "Built from: MPN GearLab notes on VAnalog Shape"}, {"name": "Formant Wraith", "category": "Lead", "settings": [["Osc 1 / Type", "Formant"], ["Osc 1 / Wave (Interval)", "30"], ["Osc 1 / Timbre (Formant)", "50"], ["Osc 1 / Shape", "40"], ["Osc 2 / Type", "BasicWaves"], ["Osc 2 / Tune", "-12 st"], ["Osc 2 / Wave (Morph)", "50"], ["Osc 2 / Volume", "30"], ["Filter / Type", "LP"], ["Filter / Cutoff", "60"], ["Filter / Resonance", "15"], ["Filter / Env Amt", "+10"], ["FX 1 / Type", "Chorus - Shaded, Amount 30"], ["FX 2 / Type", "Delay - Stereo Sync, 1/4D, Intensity 40, Amount 25"], ["FX 3 / Type", "Reverb - Hall, Time 70, Amount 35"], ["LFO 1 / Wave + Rate", "Tri, 0.25 Hz, Retrig Poly Kbd"], ["Matrix / LFO 1 > Osc 1 Timbre", "+25"], ["Matrix / Aftertouch > Osc 1 Shape", "+30"], ["Envelope / A D S R", "20 / 50 / 80 / 45"], ["Voice / Mode", "Mono"], ["Voice / Glide", "0 (off)"]], "seq": "", "play": "A moaning, vowel-shifting voice for spooky melodies. Play slow notes and press into the keys to open the vowel.", "source": "https://forums.musicplayer.com/topic/184514-in-the-lab-arturia-minifreak-v-and-minifreak-redux/", "sourceName": "Built from: MPN GearLab Formant engine notes"}, {"name": "Ashen Choir", "category": "Pad", "settings": [["Osc 1 / Type", "Harmo"], ["Osc 1 / Wave (Content)", "40"], ["Osc 1 / Timbre (Sculpting)", "30"], ["Osc 1 / Shape (Chorus)", "50"], ["Osc 2 / Type", "Phaser Filter"], ["Osc 2 / Wave (Cutoff)", "40"], ["Osc 2 / Timbre (Feedback)", "50"], ["Osc 2 / Shape (Poles)", "8"], ["Osc 2 / Volume", "70 (dry/wet)"], ["Filter / Type", "LP"], ["Filter / Cutoff", "45"], ["Filter / Resonance", "10"], ["Filter / Env Amt", "+10"], ["FX 1 / Type", "Chorus - Lush, Amount 35"], ["FX 2 / Type", "3 Bands EQ, low +2, high -3 (est.)"], ["FX 3 / Type", "Reverb - Long, Time 75, Amount 40"], ["LFO 2 / Wave + Rate", "Tri, 0.08 Hz, Retrig Free"], ["Matrix / LFO 2 > Osc 2 Wave (phaser cutoff)", "+30"], ["Envelope / A D S R", "60 / 70 / 80 / 70"], ["Voice / Mode", "Poly"]], "seq": "", "play": "An additive choir run through a slow per-voice phaser: drifting, grey dark-ambient chords. Hold minor 9 or sus chords and let the sweep breathe.", "source": "https://forums.musicplayer.com/topic/184514-in-the-lab-arturia-minifreak-v-and-minifreak-redux/", "sourceName": "Built from: MPN GearLab Phaser Filter and Harmo notes"}, {"name": "Grey Cathedral", "category": "Pad", "settings": [["Osc 1 / Type", "Wavetable (pick a dark or vocal table in Sound Edit > Osc > Wavetable Select, est.)"], ["Osc 1 / Wave", "30"], ["Osc 1 / Timbre", "40"], ["Osc 1 / Shape", "20"], ["Osc 2 / Type", "VAnalog"], ["Osc 2 / Tune", "-12 st"], ["Osc 2 / Wave (Detune)", "25"], ["Osc 2 / Volume", "40"], ["Filter / Type", "LP"], ["Filter / Cutoff", "50"], ["Filter / Resonance", "15"], ["FX 1 / Type", "Super Unison - Slow, Time 35, Amount 45"], ["FX 2 / Type", "Delay - Filtered Ping-Pong Sync, 1/2, Intensity 40, Amount 20"], ["FX 3 / Type", "Reverb - Hall, Time 80, Amount 45"], ["LFO 1 / Wave + Rate", "SlewSnH, 0.15 Hz, Retrig Free"], ["Matrix / LFO 1 > Osc 1 Wave", "+20"], ["Matrix / Keyboard (Voice mode) > Cutoff", "+5"], ["Envelope / A D S R", "70 / 60 / 90 / 80"], ["Voice / Mode", "Poly"]], "seq": "", "play": "A slowly wandering wavetable pad; smoothed random scanning keeps it from obviously looping, and each voice gets a slightly different brightness like an old poly. Try it with a wavetable you drew in the Waves tab.", "source": "https://solidtrax.nl/arturia-minifreak-review/", "sourceName": "Built from: Solidtrax (Keyboard Voice mode, Super Unison) + MusicRadar review"}, {"name": "Mourning Strings", "category": "Pad", "settings": [["Osc 1 / Type", "SawX"], ["Osc 1 / Wave (SawMod)", "20"], ["Osc 1 / Timbre (Shape)", "50"], ["Osc 1 / Shape (Noise)", "5"], ["Filter / Type", "LP"], ["Filter / Cutoff", "40"], ["Filter / Resonance", "10"], ["Filter / Env Amt", "+20"], ["FX 1 / Type", "Chorus - Dark, Amount 40"], ["FX 2 / Type", "Reverb - Long, Time 70, Amount 40"], ["LFO 1 / Wave + Rate", "Sin, 5 Hz, Retrig Poly Kbd"], ["Matrix / Aftertouch > Pitch 1+2", "+3 (est., pressure vibrato)"], ["Envelope / A D S R", "50 / 60 / 70 / 60"], ["Voice / Mode", "Para (12 voices; Osc 2 follows Osc 1)"]], "seq": "", "play": "Paraphonic SawX strings for big, slow dark chords of up to 12 notes. Press into held notes for vibrato.", "source": "https://www.youtube.com/watch?v=BYXD6jsoiPk", "sourceName": "Built from: Arturia How To on paraphony (topic only)"}, {"name": "Sodium Lamp", "category": "Drone", "settings": [["Osc 1 / Type", "Frozen (granular)"], ["Osc 1 / Sample", "Your own import: a metal scrape or field recording (WAV/AIFF/FLAC, max 6 s)"], ["Osc 1 / Wave (Start)", "40"], ["Osc 1 / Timbre (Size)", "60"], ["Osc 1 / Shape (Chaos)", "30"], ["Osc 2 / Type", "Comb Filter"], ["Osc 2 / Wave (Cutoff)", "30"], ["Osc 2 / Timbre (Gain)", "60"], ["Osc 2 / Shape (Damping)", "40"], ["Osc 2 / Volume", "70 (dry/wet)"], ["Filter / Type", "LP"], ["Filter / Cutoff", "40"], ["Filter / Resonance", "30"], ["FX 1 / Type", "Delay - Stereo, Time 60, Intensity 50, Amount 25"], ["FX 2 / Type", "Reverb - Long, Time 85, Amount 55"], ["LFO 1 / Wave + Rate", "SlewSnH, 0.1 Hz, Retrig Free"], ["Matrix / LFO 1 > Osc 1 Wave (Start)", "+15"], ["Matrix / LFO 1 > Osc 2 Wave (comb cutoff)", "+10"], ["Envelope / A D S R", "80 / - / 100 / 90"], ["Voice / Mode", "Poly"]], "seq": "", "play": "Freezes a slice of your own sample into an endless, metallic hum tuned by the comb filter. Hold one or two low notes and nudge Start slowly.", "source": "https://synthanatomy.com/2026/09/arturia-minifreak-5-0-multi-engine-polysynth-gehts-wavetable-and-sample-import.html", "sourceName": "Built from: Synth Anatomy 5.0 sample import + Frozen/Comb descriptions"}, {"name": "Below the Ward", "category": "Drone", "settings": [["Osc 1 / Type", "Bass"], ["Osc 1 / Tune", "-24 st"], ["Osc 1 / Wave (Saturate)", "30"], ["Osc 1 / Timbre (Fold)", "50"], ["Osc 1 / Shape (Noise)", "30"], ["Osc 2 / Type", "Harm"], ["Osc 2 / Tune", "-17 st (a fifth above Osc 1)"], ["Osc 2 / Wave (Spread)", "20"], ["Osc 2 / Timbre (Rectify)", "40"], ["Osc 2 / Shape (Noise)", "10"], ["Osc 2 / Volume", "50"], ["Filter / Type", "LP"], ["Filter / Cutoff", "35"], ["Filter / Resonance", "25"], ["FX 1 / Type", "Multi Comp - All Up, Amount 40"], ["FX 2 / Type", "Reverb - Dark Room, Time 80, Amount 45"], ["LFO 1 / Wave + Rate", "Tri, 0.05 Hz, Retrig Free"], ["LFO 2 / Wave + Rate", "SnH, 0.3 Hz, Retrig Free"], ["Matrix / LFO 1 > Osc 1 Timbre (Fold)", "+25"], ["Matrix / LFO 2 > Osc 2 Timbre (Rectify)", "+15"], ["Envelope / A D S R", "80 / - / 100 / 90"], ["Voice / Mode", "Mono"], ["Voice / Glide", "0 (off)"]], "seq": "", "play": "A growling sub drone with a ghostly fifth on top; slow folding and random rectifying keep it alive. One note, held for minutes.", "source": "https://www.noiseengineering.us/blog/microfreak", "sourceName": "Built from: Noise Engineering Bass/Harm notes"}, {"name": "Filter Ghost", "category": "Drone", "settings": [["Osc 1 / Type", "Noise"], ["Osc 1 / Volume", "5 (just enough to excite the filter)"], ["Osc 2 / Volume", "0"], ["Filter / Type", "LP"], ["Filter / Cutoff", "50"], ["Filter / Resonance", "100 (self-oscillating)"], ["Filter / Env Amt", "0"], ["FX 1 / Type", "Chorus - Single, Amount 30"], ["FX 2 / Type", "Delay - Ping-Pong Sync, 1/4D, Intensity 55, Amount 30"], ["FX 3 / Type", "Reverb - Long, Time 80, Amount 50"], ["LFO 1 / Wave + Rate", "Sin, 4 Hz, Retrig Poly Kbd"], ["Matrix / Keyboard > Cutoff", "+50 (key tracking)"], ["Matrix / LFO 1 > Cutoff", "+2"], ["Envelope / A D S R", "40 / - / 100 / 70"], ["Voice / Mode", "Poly"]], "seq": "", "play": "Plays the analog filter itself as a whistling, theremin-like sine with a wavering edge. Fine-tune pitch with Cutoff and keep melodies slow and sparse.", "source": "https://solidtrax.nl/arturia-minifreak-review/", "sourceName": "Built from: Solidtrax (self-resonant filter) + manual key-tracking example"}, {"name": "Rusted Harp", "category": "Pluck", "settings": [["Osc 1 / Type", "KarplusStr"], ["Osc 1 / Wave (Bow)", "0"], ["Osc 1 / Timbre (Position)", "30"], ["Osc 1 / Shape (Decay)", "60"], ["Osc 2 / Type", "Destroy"], ["Osc 2 / Wave (Fold)", "0"], ["Osc 2 / Timbre (Decimate)", "30"], ["Osc 2 / Shape (Bitcrush)", "20"], ["Osc 2 / Volume", "50 (dry/wet)"], ["Filter / Type", "LP"], ["Filter / Cutoff", "60"], ["Filter / Resonance", "10"], ["Filter / Velo Amt (Shift+Env Amt)", "+20"], ["FX 1 / Type", "Distortion - Tape, gain 20, Amount 25"], ["FX 2 / Type", "Reverb - Room, Time 40, Amount 30"], ["Envelope / A D S R", "0 / 60 / 0 / 50"], ["Voice / Mode", "Poly"]], "seq": "", "play": "A crushed, slightly sour plucked string for spooky lo-fi hip hop loops. Play minor-second and tritone figures; Position changes where the string is struck.", "source": "https://forums.musicplayer.com/topic/184514-in-the-lab-arturia-minifreak-v-and-minifreak-redux/", "sourceName": "Built from: MPN GearLab KarplusStr and Destroy notes"}, {"name": "Bone Marimba", "category": "Pluck", "settings": [["Osc 1 / Type", "Modal"], ["Osc 1 / Wave (Inharm)", "40"], ["Osc 1 / Timbre", "40"], ["Osc 1 / Shape (Decay)", "40"], ["Osc 2 / Volume", "0"], ["Filter / Type", "LP"], ["Filter / Cutoff", "70"], ["Filter / Resonance", "5"], ["FX 1 / Type", "Delay - Filtered Sync, 1/8D, Intensity 35, Amount 25"], ["FX 2 / Type", "Reverb - Dark Room, Time 45, Amount 30"], ["Matrix / Velocity > Osc 1 Shape (Decay)", "+30"], ["Envelope / A D S R", "0 / 70 / 0 / 60"], ["Voice / Mode", "Poly"]], "seq": "", "play": "Hollow mallet hits that ring longer the harder you play. Raise Inharm toward 70 for a more bone-and-metal clank.", "source": "https://forums.musicplayer.com/topic/184514-in-the-lab-arturia-minifreak-v-and-minifreak-redux/", "sourceName": "Built from: MPN GearLab Modal tip (velocity to Decay)"}, {"name": "Tin Lung Bell", "category": "Keys", "settings": [["Osc 1 / Type", "Two Op. FM"], ["Osc 1 / Wave (Ratio)", "non-integer region, about 63 (est.)"], ["Osc 1 / Timbre (Amount)", "40"], ["Osc 1 / Shape (Feedback)", "15"], ["Osc 2 / Type", "FM / RM"], ["Osc 2 / Wave", "sine region (est.)"], ["Osc 2 / Timbre (FreqMod)", "10"], ["Osc 2 / Shape (RingMod)", "35"], ["Osc 2 / Volume", "40"], ["Filter / Type", "LP"], ["Filter / Cutoff", "65"], ["Filter / Resonance", "0"], ["Filter / Env Amt", "+20"], ["FX 1 / Type", "Chorus - Default, Amount 20"], ["FX 2 / Type", "Reverb - Hall, Time 70, Amount 40"], ["Envelope / A D S R", "0 / 70 / 0 